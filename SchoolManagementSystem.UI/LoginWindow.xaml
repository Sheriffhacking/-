<Window x:Class="SchoolManagementSystem.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        Height="643"
        Width="487"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Grid RenderTransformOrigin="0.5,0.5" Margin="-87,38,19,0" Height="904" VerticalAlignment="Top">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="-0.429"/>
                <TranslateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Card Container -->
        <Border Width="361"
                Padding="25"
                CornerRadius="12"
                Background="White"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Effect="{DynamicResource DropShadowEffect}" Height="566" Margin="148,-6,0,0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.452"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>

            <StackPanel>

                <!-- Title -->
                <TextBlock Text="تسجيل الدخول"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#2D2D2D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Username -->
                <TextBlock Text="اسم المستخدم"
                           FontSize="13"
                           Foreground="#555"/>

                <TextBox x:Name="txtUsername"
                         Height="38"
                         Margin="0,5,0,15"
                         Padding="8"
                         FontSize="14"
                         BorderBrush="#D0D0D0"
                         Background="#FAFAFA"/>

                <!-- Password -->
                <TextBlock Text="كلمة المرور"
                           FontSize="13"
                           Foreground="#555"/>

                <PasswordBox x:Name="txtPassword"
                             Height="38"
                             Margin="0,5,0,20"
                             Padding="8"
                             FontSize="14"
                             BorderBrush="#D0D0D0"
                             Background="#FAFAFA"/>
                <!-- Old Password -->
                <TextBlock Text="كلمة المرور القديمة"
           FontSize="13"
           Foreground="#555"
           Margin="0,10,0,0"/>

                <PasswordBox x:Name="txtOldPassword"
             Height="38"
             Margin="0,5,0,10"
             Padding="8"/>

                <!-- New Password -->
                <TextBlock Text="كلمة المرور الجديدة"
           FontSize="13"
           Foreground="#555"/>

                <PasswordBox x:Name="txtNewPassword"
             Height="38"
             Margin="0,5,0,15"
             Padding="8"/>

                <!-- Buttons -->
                <Button Content="تسجيل الدخول"
        Height="42"
        Background="#2D6CDF"
        Foreground="White"
        FontWeight="Bold"
        Click="Login_Click"/>

                <Button Content="تحديث كلمة المرور"
        Height="38"
        Margin="0,10,0,0"
        Background="#444"
        Foreground="White"
        Click="UpdatePassword_Click"/>

                <!-- Login Button -->
                <Button Content="تسجيل الدخول"
                        Height="42"
                        Background="#2D6CDF"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand"
                        BorderThickness="0"
                        Click="Login_Click"/>

                <!-- Footer -->
                <TextBlock Text="© School Management System"
                           FontSize="11"
                           Foreground="#999"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>