<Window x:Class="SchoolManagementSystem.UI.FinanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="النظام المالي"
        Height="900"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F4F6F9"
        Loaded="Window_Loaded">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </Window.Resources>

    <!-- ================= SCROLL ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0"
                    Background="#1E293B"
                    Padding="20"
                    Margin="0,0,0,15"
                    CornerRadius="10">

                <DockPanel>

                    <TextBlock Text="💰"
                               FontSize="34"
                               Foreground="White"
                               Margin="10,0"/>

                    <TextBlock Text="النظام المالي المتكامل (ERP Finance)"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center" TextAlignment="Center"/>

                </DockPanel>

            </Border>

            <!-- ================= INPUT ================= -->
            <Border Grid.Row="1"
        Background="White"
        Margin="0,0,0,10"
        CornerRadius="10">

                <Expander Header="📌 إدخال العمليات المالية"
              IsExpanded="True">

                    <Grid Margin="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <!-- ================= ROW 0 ================= -->

                        <TextBlock Text="نوع الحركة:"
                       Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbType"
                      Grid.Row="0"
                      Grid.Column="1"
                      SelectionChanged="cmbType_SelectionChanged"/>

                        <TextBlock Text="نوع الرسوم:"
                       Grid.Row="0"
                       Grid.Column="2"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbFeeType"
                      Grid.Row="0"
                      Grid.Column="3"
                      DisplayMemberPath="FeeName"
                      SelectedValuePath="FeeTypeId"/>

                        <TextBlock Text="السنة:"
                       Grid.Row="0"
                       Grid.Column="4"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbAcademicYear"
                      Grid.Row="0"
                      Grid.Column="5"/>


                        <!-- ================= ROW 1 ================= -->

                        <TextBlock Text="الطالب:"
                       Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="txtStudentSearch"
             Grid.Row="0"
             Height="36"
             Margin="5"
             Padding="8"
             FontSize="13"
             ToolTip="ابحث باسم الطالب"
             TextChanged="txtStudentSearch_TextChanged"
             LostFocus="txtStudentSearch_LostFocus"/>

                            <Popup x:Name="popupStudents"
           PlacementTarget="{Binding ElementName=txtStudentSearch}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True">

                                <Border Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Effect="{x:Null}">

                                    <ListBox x:Name="lstStudentResults"
                     MaxHeight="180"
                     Width="240"
                     FontSize="13"
                     DisplayMemberPath="FullName"
                     MouseLeftButtonUp="lstStudentResults_MouseLeftButtonUp"
                     KeyDown="lstStudentResults_KeyDown"/>
                                </Border>

                            </Popup>
                        </Grid>

                        <TextBlock Text="الموظف:"
                       Grid.Row="1"
                       Grid.Column="2"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbEmployees"
                      Grid.Row="1"
                      Grid.Column="3"
                      DisplayMemberPath="EmployeeName"
                      SelectedValuePath="EmployeeId"/>

                        <TextBlock Text="الشهر:"
                       Grid.Row="1"
                       Grid.Column="4"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbMonth"
                      Grid.Row="1"
                      Grid.Column="5"/>

                        <!-- ================= ROW 2 ================= -->

                        <TextBlock Text="إجمالي المبلغ المطلوب:"
                       Grid.Row="2"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

                        <TextBox x:Name="txtTotalRequiredAmount"
                     Grid.Row="2"
                     Grid.Column="1"
                     TextAlignment="Left"
                     Background="#FEF9C3"
                     FontWeight="Bold"
                     ToolTip="أدخل إجمالي الرسوم المطلوبة"/>

                        <TextBlock Text="المبلغ المدفوع:"
                       Grid.Row="2"
                       Grid.Column="2"
                       VerticalAlignment="Center"/>

                        <TextBox x:Name="txtAmount"
                     Grid.Row="2"
                     Grid.Column="3"
                     TextAlignment="Left"/>

                        <TextBlock Text="اجمالي المتبقي:"
                       Grid.Row="2"
                       Grid.Column="4"
                       VerticalAlignment="Center"/>

                        <TextBox x:Name="txtRemainingAmount"
                     Grid.Row="2"
                     Grid.Column="5"
                     TextAlignment="Left"
                     Background="#FEE2E2"
                     FontWeight="Bold"
                     IsReadOnly="True"/>

                        <!-- ================= ROW 3 ================= -->

                        <TextBlock Text="طريقة الدفع:"
                       Grid.Row="3"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbPaymentMethod"
                      Grid.Row="3"
                      Grid.Column="1"/>

                        <TextBlock Text="الوصف:"
                       Grid.Row="3"
                       Grid.Column="2"
                       VerticalAlignment="Center"/>

                        <TextBox x:Name="txtDesc"
                     Grid.Row="3"
                     Grid.Column="3"
                     Grid.ColumnSpan="3"
                     TextAlignment="Right"/>

                        <!-- ================= ROW 4 ================= -->

                        <TextBlock Text="التاريخ:"
                       Grid.Row="4"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

                        <DatePicker x:Name="dpTransactionDate"
                        Grid.Row="4"
                        Grid.Column="1"/>

                    </Grid>

                </Expander>

            </Border>

            <!-- ================= FILTERS ================= -->
            <Border Grid.Row="2"
                    Background="White"
                    Margin="0,0,0,10"
                    CornerRadius="10">

                <Expander Header="🔍 الفلاتر والبحث">

                    <WrapPanel Margin="10" Orientation="Horizontal">

                        <TextBlock Text="من التاريخ:" VerticalAlignment="Center" Margin="5,0"/>
                        <DatePicker x:Name="dpFrom" Width="150"/>

                        <TextBlock Text="إلى التاريخ:" VerticalAlignment="Center" Margin="5,0"/>
                        <DatePicker x:Name="dpTo" Width="150"/>

                        <TextBlock Text="النوع:" VerticalAlignment="Center" Margin="5,0"/>
                        <ComboBox x:Name="cmbFilterType" Width="150"/>

                        <TextBlock Text="الرسوم:" VerticalAlignment="Center" Margin="5,0"/>
                        <ComboBox x:Name="cmbFilterFeeType"
                                  Width="150"
                                  DisplayMemberPath="FeeName"
                                  SelectedValuePath="FeeTypeId"/>

                        <TextBlock Text="الشهر:" VerticalAlignment="Center" Margin="5,0"/>
                        <ComboBox x:Name="cmbFilterMonth" Width="120"/>
                        <CheckBox x:Name="chkHasRemaining"
          Content="لديهم مبلغ متبقي فقط"
          VerticalAlignment="Center"
          Margin="10,0"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="#DC2626"/>

                        <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <TextBox x:Name="txtSearch" Width="200" Height="30" Margin="5,0" ToolTip="أدخل نص للبحث في جميع الحقول"/>

                        <Button Content="🔍 فلترة"
                                Width="120"
                                Background="#0284C7"
                                Click="Filter_Click"/>

                        <Button Content="🔄 إعادة تعيين"
                                Width="140"
                                Background="#6B7280"
                                Click="ResetFilter_Click"/>

                    </WrapPanel>

                </Expander>

            </Border>

            <!-- ================= ACTION BUTTONS ================= -->
            <Border Grid.Row="3"
                    Background="White"
                    Margin="0,0,0,10"
                    CornerRadius="10">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="💾 إضافة"
                            Width="140"
                            Background="#16A34A"
                            Click="Add_Click"/>

                    <Button Content="✏️ تعديل"
                            Width="140"
                            Background="#2563EB"
                            Click="Edit_Click"/>

                    <Button Content="🗑 حذف"
                            Width="120"
                            Background="#DC2626"
                            Click="Delete_Click"/>

                    <Button Content="🔄 تحديث"
                            Width="120"
                            Background="#7C3AED"
                            Click="Refresh_Click"/>

                    <Button Content="📄 طباعة"
                            Width="120"
                            Background="#EA580C"/>

                    <Button Content="📊 Excel"
                            Background="#0F766E"
                            Width="130"
                            Click="Excel_Click"/>

                </StackPanel>

            </Border>

            <!-- ================= DASHBOARD ================= -->
            <UniformGrid Grid.Row="4" Columns="6" Margin="0,0,0,10">

                <Border Background="#10B981" CornerRadius="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="الإيرادات" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="txtIncome" FontSize="22" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Background="#F59E0B" CornerRadius="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="المصاريف" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="txtExpenses" FontSize="22" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Background="#8B5CF6" CornerRadius="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="الرواتب" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="txtSalaries" FontSize="22" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Background="#2563EB" CornerRadius="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="الأرباح" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="txtProfit" FontSize="22" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- ✅ جديد: إجمالي المتبقي + -->
                <Border Background="#0D9488" CornerRadius="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="إجمالي المتبقي +" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTotalRemainingPlus"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       ToolTip="مجموع المبالغ المتبقية على الطلاب (قبض)"/>
                    </StackPanel>
                </Border>

                <!-- ✅ جديد: إجمالي المتبقي - -->
                <Border Background="#DC2626" CornerRadius="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="إجمالي المتبقي -" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTotalRemainingMinus"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       ToolTip="مجموع المبالغ المتبقية على المدفوعات (راتب + صرف)"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ================= DATA GRID ================= -->
            <Border Grid.Row="5"
                    Background="White"
                    Margin="0,10"
                    CornerRadius="10">

                <DataGrid x:Name="dgTransactions"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Height="400"
                          MouseDoubleClick="dgTransactions_MouseDoubleClick"
                          SelectionMode="Single">

                    <DataGrid.Columns>


                        <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="80"/>

                        <DataGridTextColumn Header="المبلغ"
                        Binding="{Binding Amount, StringFormat=N2}"
                        Width="100"/>

                        <DataGridTextColumn Header="إجمالي المطلوب"
                    Binding="{Binding TotalRequiredAmount, StringFormat=N2}"
                    Width="130"/>

                        <DataGridTextColumn Header="إجمالي المتبقي"
                    Binding="{Binding RemainingAmount, StringFormat=N2}"
                    Width="120"/>
                        <DataGridTextColumn Header="الطالب" Binding="{Binding StudentName}" Width="120"/>
                        <DataGridTextColumn Header="الرسوم" Binding="{Binding FeeName}" Width="120"/>
                        <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="120"/>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="200"/>
                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="100"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </ScrollViewer>

</Window>