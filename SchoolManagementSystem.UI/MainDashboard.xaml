<Window x:Class="SchoolManagementSystem.UI.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="لوحة التحكم الرئيسية - مدرسة جسور التعليمية"
        Height="800"
        Width="1340"
        WindowStartupLocation="CenterScreen"
        Background="#060E1F"
        FlowDirection="RightToLeft"
        ResizeMode="CanMinimize"

        MinHeight="700"
        MinWidth="1200"

        Padding="0"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

        <!-- ===== Color Palette ===== -->
        <SolidColorBrush x:Key="DarkBg"         Color="#060E1F"/>
        <SolidColorBrush x:Key="PanelBg"        Color="#0D1B33"/>
        <SolidColorBrush x:Key="CardBg"         Color="#0F2144"/>
        <SolidColorBrush x:Key="CardBgHover"    Color="#142A56"/>
        <SolidColorBrush x:Key="AccentBlue"     Color="#1D6FE8"/>
        <SolidColorBrush x:Key="AccentGold"     Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentGreen"    Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRose"     Color="#F43F5E"/>
        <SolidColorBrush x:Key="AccentViolet"   Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentCyan"     Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentOrange"   Color="#F97316"/>
        <SolidColorBrush x:Key="BorderGlow"     Color="#1D6FE8"/>
        <SolidColorBrush x:Key="TextWhite"      Color="#F0F6FF"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#64748B"/>
        <SolidColorBrush x:Key="TextSub"        Color="#94A3B8"/>
        <SolidColorBrush x:Key="Divider"        Color="#1A2E4A"/>

        <!-- ===== Header Style ===== -->
        <Style x:Key="HeaderPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1B33"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="24,18"/>
            <Setter Property="BorderBrush" Value="#1A2E4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="#000D1F"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Action Button Style ===== -->
        <Style x:Key="ActionButtonStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Stat Card Style ===== -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1B33"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderBrush" Value="#1A2E4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="170"/>
        </Style>

        <!-- ===== Main Card Style ===== -->
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Width" Value="292"/>
            <Setter Property="Height" Value="165"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="#0F2144"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#1A2E4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#000D1F"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- ===== Subtle Background Glows ===== -->
        <Ellipse Width="600" Height="600"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-300,-280,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#0D2E6B" Offset="0"/>
                    <GradientStop Color="#060E1F" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="500" Height="500"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-250,-250">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A0A3D" Offset="0"/>
                    <GradientStop Color="#060E1F" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="28,48,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================================= -->
            <!-- ROW 0 : HEADER                            -->
            <!-- ========================================= -->
            <Border Grid.Row="0" Style="{StaticResource HeaderPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LOGO BADGE -->
                    <Border Width="78" Height="78" CornerRadius="20"
                            Grid.Column="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D6FE8" Offset="0"/>
                                <GradientStop Color="#3B46F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#1D6FE8"/>
                        </Border.Effect>
                        <TextBlock Text="🏫" FontSize="36"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- TITLE BLOCK -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="مدرسة جسور التعليمية الخاصة"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="#F0F6FF"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Background="#0F2144" CornerRadius="8"
                                    Padding="10,4" Margin="0,0,8,0"
                                    BorderBrush="#1D6FE8" BorderThickness="1">
                                <TextBlock Text="✦  نظام إدارة مدرسي متكامل"
                                           FontSize="13" Foreground="#60A5FA"/>
                            </Border>
                            <Border Background="#0A2B1A" CornerRadius="8"
                                    Padding="10,4"
                                    BorderBrush="#10B981" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#10B981"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="النظام يعمل بكفاءة"
                                               FontSize="13" Foreground="#34D399"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ACTION BUTTONS -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- BACKUP -->
                        <!-- CLOSE -->
                        <Border Style="{StaticResource ActionButtonStyle}"
        MouseLeftButtonUp="Close_Click">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DC2626" Offset="0"/>
                                    <GradientStop Color="#F43F5E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                          ShadowDepth="0"
                          Opacity="0.6"
                          Color="#DC2626"/>
                            </Border.Effect>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Foreground="White"/>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="إغلاق"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="Bold"/>

                                    <TextBlock Text="إغلاق النظام"
                       Foreground="#FFE4E6"
                       FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- BACKUP -->
                        <Border Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,10,0" MouseLeftButtonUp="Backup_Click">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1D4ED8" Offset="0"/>
                                    <GradientStop Color="#1D6FE8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="نسخ احتياطي" Foreground="White"
                                               FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="حفظ النظام" Foreground="#BFDBFE" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- RESTORE -->
                        <Border Style="{StaticResource ActionButtonStyle}"
                                MouseLeftButtonUp="Restore_Click">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#059669" Offset="0"/>
                                    <GradientStop Color="#10B981" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♻" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="استعادة" Foreground="White"
                                               FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="نسخة محفوظة" Foreground="#A7F3D0" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================= -->
            <!-- ROW 2 : QUICK STATS BAR                  -->
            <!-- ========================================= -->
            <Border Grid.Row="2"
                    Background="#0D1B33"
                    CornerRadius="18"
                    Padding="20,14"
                    BorderBrush="#1A2E4A"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Stat 1 -->
                    <Border Style="{StaticResource StatCardStyle}" Margin="0,0,10,0"
                            BorderBrush="#1D3A6B">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👨‍🎓" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="الطلاب" FontSize="12" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="620" FontSize="22" FontWeight="Bold"
                                       Foreground="#60A5FA" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Rectangle Width="1" Fill="#1A2E4A" Margin="0,8"/>

                    <!-- Stat 2 -->
                    <Border Style="{StaticResource StatCardStyle}" Margin="10,0"
                            BorderBrush="#1A3A2A">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👩‍🏫" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="المعلمون" FontSize="12" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="10" FontSize="22" FontWeight="Bold"
                                       Foreground="#34D399" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Fill="#1A2E4A" Margin="0,8"/>

                    <!-- Stat 3 -->
                    <Border Style="{StaticResource StatCardStyle}" Margin="10,0"
                            BorderBrush="#3A2A10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏫" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="الصفوف" FontSize="12" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="9" FontSize="22" FontWeight="Bold"
                                       Foreground="#FCD34D" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Fill="#1A2E4A" Margin="0,8"/>

                    <!-- Stat 4 -->
                    <Border Style="{StaticResource StatCardStyle}" Margin="10,0"
                            BorderBrush="#2A1A3A">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📅" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="نسبة الحضور" FontSize="12" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="98%" FontSize="22" FontWeight="Bold"
                                       Foreground="#C084FC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Fill="#1A2E4A" Margin="0,8"/>

                    <!-- Stat 5 -->
                    <Border Style="{StaticResource StatCardStyle}" Margin="10,0,0,0"
                            BorderBrush="#1A2E10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💰" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="الرسوم المحصّلة" FontSize="12" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="92%" FontSize="22" FontWeight="Bold"
                                       Foreground="#6EE7B7" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ========================================= -->
            <!-- ROW 4 : MAIN NAVIGATION CARDS            -->
            <!-- ========================================= -->
            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="4">

                <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">

                    <!-- ── STUDENTS ── -->
                    <Border Style="{StaticResource ModernCardStyle}"
                            MouseLeftButtonUp="OpenStudents_Click"
                            BorderBrush="#1D3A6B">
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Icon Badge -->
                            <Border Width="48" Height="48" CornerRadius="14"
                                    HorizontalAlignment="Right">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1D4ED8" Offset="0"/>
                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6" Color="#1D4ED8"/>
                                </Border.Effect>
                                <TextBlock Text="👨‍🎓" FontSize="24"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Title -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="إدارة الطلاب"
                                           FontSize="22" FontWeight="Bold" Foreground="#F0F6FF"/>
                                <TextBlock Text="تسجيل ومتابعة الطلاب"
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Bottom Accent -->
                            <Border Grid.Row="2" Height="3" CornerRadius="2" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#060E1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── CLASSES ── -->
                    <Border Style="{StaticResource ModernCardStyle}"
                            MouseLeftButtonUp="OpenClasses_Click"
                            BorderBrush="#3A2A10">
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14"
                                    HorizontalAlignment="Right">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#B45309" Offset="0"/>
                                        <GradientStop Color="#F59E0B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6" Color="#B45309"/>
                                </Border.Effect>
                                <TextBlock Text="🏫" FontSize="24"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="إدارة الصفوف"
                                           FontSize="22" FontWeight="Bold" Foreground="#F0F6FF"/>
                                <TextBlock Text="الشعب والجداول الدراسية"
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="2" Height="3" CornerRadius="2" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#060E1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── ATTENDANCE ── -->
                    <Border Style="{StaticResource ModernCardStyle}"
                            MouseLeftButtonUp="Attendance_Click"
                            BorderBrush="#1A3A2A">
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14"
                                    HorizontalAlignment="Right">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#047857" Offset="0"/>
                                        <GradientStop Color="#10B981" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6" Color="#047857"/>
                                </Border.Effect>
                                <TextBlock Text="📋" FontSize="24"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="الحضور والغياب"
                                           FontSize="22" FontWeight="Bold" Foreground="#F0F6FF"/>
                                <TextBlock Text="تسجيل الحضور اليومي"
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="2" Height="3" CornerRadius="2" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#060E1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── GRADES ── -->
                    <Border Style="{StaticResource ModernCardStyle}"
                            MouseLeftButtonUp="Grades_Click"
                            BorderBrush="#2A1A3A">
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14"
                                    HorizontalAlignment="Right">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6D28D9" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6" Color="#6D28D9"/>
                                </Border.Effect>
                                <TextBlock Text="📊" FontSize="24"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="الدرجات والتقييم"
                                           FontSize="22" FontWeight="Bold" Foreground="#F0F6FF"/>
                                <TextBlock Text="نتائج الاختبارات والأداء"
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="2" Height="3" CornerRadius="2" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#060E1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── ANALYTICS ── -->
                    <Border Style="{StaticResource ModernCardStyle}"
                            MouseLeftButtonUp="Analytics_Click"
                            BorderBrush="#0D2A3A">
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14"
                                    HorizontalAlignment="Right">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0E7490" Offset="0"/>
                                        <GradientStop Color="#06B6D4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6" Color="#0E7490"/>
                                </Border.Effect>
                                <TextBlock Text="📈" FontSize="24"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="التحليلات والتقارير"
                                           FontSize="22" FontWeight="Bold" Foreground="#F0F6FF"/>
                                <TextBlock Text="إحصاءات وتقارير شاملة"
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="2" Height="3" CornerRadius="2" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="#06B6D4" Offset="0"/>
                                        <GradientStop Color="#060E1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── FINANCE ── -->
                    <Border Style="{StaticResource ModernCardStyle}"
                            MouseLeftButtonUp="Finance_Click"
                            BorderBrush="#1A3A10">
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14"
                                    HorizontalAlignment="Right">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#15803D" Offset="0"/>
                                        <GradientStop Color="#22C55E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6" Color="#15803D"/>
                                </Border.Effect>
                                <TextBlock Text="💰" FontSize="24"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="الحسابات المالية"
                                           FontSize="22" FontWeight="Bold" Foreground="#F0F6FF"/>
                                <TextBlock Text="الرسوم والمصاريف والرواتب"
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="2" Height="3" CornerRadius="2" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#060E1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- ═════ QUICK TIMETABLE ACCESS (MODERN CARDS) ═════ -->
                    <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,10,0,10">

                        <!-- CLASS TIMETABLE CARD -->
                        <Border Width="240" Height="90"
            CornerRadius="16"
            Margin="0,0,12,0"
            Cursor="Hand"
            MouseLeftButtonUp="OpenClassTimetable">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1D6FE8" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                              Opacity="0.45" Color="#1D6FE8"/>
                            </Border.Effect>

                            <Grid Margin="14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="📋"
                       FontSize="28"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="جدول الصفوف"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"/>

                                    <TextBlock Text="عرض وإدارة حصص الصفوف"
                           FontSize="11"
                           Foreground="#DCEBFF"/>

                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- TEACHER TIMETABLE CARD -->
                        <Border Width="240" Height="90"
            CornerRadius="16"
            Cursor="Hand"
            MouseLeftButtonUp="OpenTeacherTimetable">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                              Opacity="0.45" Color="#8B5CF6"/>
                            </Border.Effect>

                            <Grid Margin="14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="👨‍🏫"
                       FontSize="28"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="جدول المدرسين"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"/>

                                    <TextBlock Text="عرض حصص كل مدرس"
                           FontSize="11"
                           Foreground="#E9D5FF"/>

                                </StackPanel>

                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- ── EMPLOYEES ── -->
                    <Border Style="{StaticResource ModernCardStyle}"
                            MouseLeftButtonUp="Employees_Click"
                            BorderBrush="#3A1A1A">
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14"
                                    HorizontalAlignment="Right">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#BE123C" Offset="0"/>
                                        <GradientStop Color="#F43F5E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6" Color="#BE123C"/>
                                </Border.Effect>
                                <TextBlock Text="👩‍🏫" FontSize="24"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="الموظفون"
                                           FontSize="22" FontWeight="Bold" Foreground="#F0F6FF"/>
                                <TextBlock Text="إدارة الكادر التعليمي والإداري"
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="2" Height="3" CornerRadius="2" Margin="0,8,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="#F43F5E" Offset="0"/>
                                        <GradientStop Color="#060E1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    
                </WrapPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
