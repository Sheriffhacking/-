<Window x:Class="SchoolManagementSystem.UI.StudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الطلاب"
        Height="820"
        Width="1200"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="#0B1425">

    <Window.Resources>

        <!-- ===== Brushes ===== -->
        <SolidColorBrush x:Key="PageBg"       Color="#0B1425"/>
        <SolidColorBrush x:Key="PanelBg"      Color="#0F1E35"/>
        <SolidColorBrush x:Key="InputBg"      Color="#162238"/>
        <SolidColorBrush x:Key="BorderCol"    Color="#1E3352"/>
        <SolidColorBrush x:Key="AccBlue"      Color="#2563EB"/>
        <SolidColorBrush x:Key="AccGreen"     Color="#10B981"/>
        <SolidColorBrush x:Key="AccRed"       Color="#EF4444"/>
        <SolidColorBrush x:Key="AccOrange"    Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrim"     Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#64748B"/>
        <SolidColorBrush x:Key="TextSub"      Color="#94A3B8"/>

        <!-- ===== Label Style ===== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#64748B"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- ===== TextBox Style ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Foreground"      Value="#F1F5F9"/>
            <Setter Property="Background"      Value="#162238"/>
            <Setter Property="BorderBrush"     Value="#1E3352"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== ComboBox Style ===== -->
        <Style TargetType="ComboBox">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="#0EA5E9"/>
            <Setter Property="Background"      Value="#162238"/>
            <Setter Property="BorderBrush"     Value="#1E3352"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===== DatePicker Style ===== -->
        <Style TargetType="DatePicker">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="#F1F5F9"/>
            <Setter Property="Background"      Value="#162238"/>
            <Setter Property="BorderBrush"     Value="#1E3352"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===== DataGrid Style ===== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"            Value="#0F1E35"/>
            <Setter Property="Foreground"            Value="#CBD5E1"/>
            <Setter Property="BorderThickness"       Value="0"/>
            <Setter Property="RowBackground"         Value="#0F1E35"/>
            <Setter Property="AlternatingRowBackground" Value="#122040"/>
            <Setter Property="GridLinesVisibility"   Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1E3352"/>
            <Setter Property="ColumnHeaderHeight"    Value="38"/>
            <Setter Property="RowHeight"             Value="34"/>
            <Setter Property="SelectionMode"         Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#0B1A2E"/>
            <Setter Property="Foreground"   Value="#64748B"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="10,0"/>
            <Setter Property="BorderBrush"  Value="#1E3352"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A6E"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#162A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Action Button Base ===== -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"      Value="38"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Padding"     Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER                                                        -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                Background="#0F1E35"
                CornerRadius="16"
                Padding="20,0"
                BorderBrush="#1E3352"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Icon + Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D4ED8" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="👨‍🎓" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إدارة الطلاب"
                                   FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="انقر نقرتين على الطالب لعرض ملفه الكامل"
                                   FontSize="11" Foreground="#475569"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="2"
                        Background="#162238"
                        CornerRadius="10"
                        BorderBrush="#1E3352"
                        BorderThickness="1"
                        Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center"
                                   Margin="0,0,8,0" Foreground="#475569"/>
                        <TextBox x:Name="txtSearch"
                                 Grid.Column="1"
                                 Height="36"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#F1F5F9"
                                 VerticalContentAlignment="Center"
                                 TextChanged="txtSearch_TextChanged"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- MAIN FORM AREA                                               -->
        <!-- ============================================================ -->
        <Border Grid.Row="2"
                Background="#0F1E35"
                CornerRadius="16"
                BorderBrush="#1E3352"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Photo + Attachments column -->
                    <ColumnDefinition Width="200"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <!-- Form fields -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================= -->
                <!-- LEFT PANEL: Photo + Attach    -->
                <!-- ============================= -->
                <Grid Grid.Column="0" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Photo Preview -->
                    <TextBlock Grid.Row="0" Text="صورة الطالب"
                               Style="{StaticResource FieldLabel}"/>

                    <Border Grid.Row="2"
                            Width="168" Height="168"
                            CornerRadius="16"
                            BorderBrush="#1E3352"
                            BorderThickness="2"
                            Background="#162238"
                            Cursor="Hand"
                            MouseLeftButtonUp="PickPhoto_Click"
                            HorizontalAlignment="Center">
                        <Grid>
                            <!-- Placeholder -->
                            <StackPanel x:Name="pnlPhotoPlaceholder"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="📷" FontSize="36"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="انقر لاختيار صورة"
                                           FontSize="11" Foreground="#475569"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <!-- Live Preview Image -->
                            <Image x:Name="imgStudentPhoto"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="14" RadiusY="14"
                                        Rect="0,0,168,168"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Change / Remove photo buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="تغيير"
                                Style="{StaticResource ActionBtn}"
                                Background="#1D4ED8"
                                Height="30" FontSize="11" Padding="10,0"
                                Margin="0,0,6,0"
                                Click="PickPhoto_Click"/>
                        <Button Content="حذف"
                                Style="{StaticResource ActionBtn}"
                                Background="#374151"
                                Height="30" FontSize="11" Padding="10,0"
                                Click="RemovePhoto_Click"/>
                    </StackPanel>

                    <!-- Attachments Button -->
                    <Button Grid.Row="6"
                            x:Name="btnAttachments"
                            Style="{StaticResource ActionBtn}"
                            Background="#1E3352"
                            Height="52"
                            Margin="0,0,0,0"
                            Click="Attachments_Click">
                        <StackPanel>
                            <TextBlock Text="📎 مرفقات الطالب"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblAttachCount"
                                       Text="لا توجد مرفقات"
                                       FontSize="10" Foreground="#475569"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="1" Fill="#1E3352"/>

                <!-- ============================= -->
                <!-- RIGHT PANEL: Form Fields      -->
                <!-- ============================= -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,16,20,16">
                    <StackPanel>

                        <!-- Row 1: Name + NationalId -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم الطالب الكامل"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="رقم الهوية الوطنية"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNationalId"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Class + Gender -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الصف الدراسي"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbClasses"
                                          DisplayMemberPath="ClassName"
                                          SelectedValuePath="ClassId"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الجنس"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbGender">
                                    <ComboBoxItem Content="ذكر"/>
                                    <ComboBoxItem Content="أنثى"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: DOB + Phone -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="تاريخ الميلاد"
                                           Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="dpBirth"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="رقم الهاتف"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPhone"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: Guardian + Guardian ID -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم ولي الأمر"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtGuardianName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="هوية ولي الأمر"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtGuardianId"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 5: PreviousClass + GPA -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الصف السابق"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPreviousClass"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="المعدل السابق"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtGpa"/>
                            </StackPanel>
                        </Grid>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="#1E3352" Margin="0,0,0,16"/>

                        <!-- Action Buttons -->
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="💾  حفظ"
                                    Style="{StaticResource ActionBtn}"
                                    Background="#059669"
                                    Margin="0,0,8,0"
                                    Click="SaveStudent_Click"/>

                            <Button Content="✏  تعديل"
                                    Style="{StaticResource ActionBtn}"
                                    Background="#2563EB"
                                    x:Name="btnUpdate"
                                    IsEnabled="False"
                                    Margin="0,0,8,0"
                                    Click="UpdateStudent_Click"/>

                            <Button Content="🗑  حذف"
                                    Style="{StaticResource ActionBtn}"
                                    Background="#DC2626"
                                    Margin="0,0,8,0"
                                    Click="DeleteStudent_Click"/>

                            <Button Content="＋  جديد"
                                    Style="{StaticResource ActionBtn}"
                                    Background="#D97706"
                                    Click="NewStudent_Click"/>
                            <Button Content="📤 تصدير Excel"
        Style="{StaticResource ActionBtn}"
        Background="#7C3AED"
        Margin="0,0,8,0"
        Click="ExportExcel_Click"/>

                            <Button Content="📥 استيراد Excel"
        Style="{StaticResource ActionBtn}"
        Background="#0EA5E9"
        Margin="0,0,8,0"
        Click="ImportExcel_Click"/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- DATA GRID                                                     -->
        <!-- ============================================================ -->
        <Border Grid.Row="4"
                Background="#0F1E35"
                CornerRadius="16"
                BorderBrush="#1E3352"
                BorderThickness="1"
                Padding="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Grid Header Bar -->
                <Border Grid.Row="0"
                        Background="#0B1A2E"
                        CornerRadius="16,16,0,0"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="قائمة الطلاب"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#64748B"/>
                        <TextBlock Text=" — انقر نقرتين لعرض الملف الكامل"
                                   FontSize="11" Foreground="#334155"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="dgStudents"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="dgStudents_SelectionChanged"
                          MouseDoubleClick="dgStudents_MouseDoubleClick"
                          BorderThickness="0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding StudentId}"
                                            Width="55"/>
                        <DataGridTextColumn Header="اسم الطالب"
                                            Binding="{Binding FullName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="الهوية"
                                            Binding="{Binding NationalId}"
                                            Width="120"/>
                        <DataGridTextColumn Header="الصف"
                                            Binding="{Binding ClassName}"
                                            Width="100"/>
                        <DataGridTextColumn Header="الجنس"
                                            Binding="{Binding Gender}"
                                            Width="70"/>
                        <DataGridTextColumn Header="الهاتف"
                                            Binding="{Binding Phone}"
                                            Width="110"/>
                        <DataGridTextColumn Header="ولي الأمر"
                                            Binding="{Binding GuardianName}"
                                            Width="140"/>
                        <DataGridTextColumn Header="المعدل"
                                            Binding="{Binding PreviousGPA}"
                                            Width="70"/>
                        <DataGridCheckBoxColumn Header="نشط"
                                                Binding="{Binding IsActive}"
                                                Width="55"/>
                    </DataGrid.Columns>

                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</Window>
