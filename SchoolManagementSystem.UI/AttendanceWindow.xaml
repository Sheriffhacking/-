<Window x:Class="SchoolManagementSystem.UI.AttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="نظام الحضور والغياب"
        Height="820"
        Width="1300"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER (CARD STYLE) ================= -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="15"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#E0E6ED"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- التاريخ -->
                <TextBlock Text="التاريخ:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="5"/>

                <DatePicker x:Name="dpDate"
                            Grid.Column="1"
                            Height="32"
                            Margin="5"/>

                <!-- الصف -->
                <TextBlock Text="الصف:"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="10,0"/>

                <ComboBox x:Name="cmbClass"
                          Grid.Column="3"
                          Height="32"
                          DisplayMemberPath="ClassName"
                          SelectedValuePath="ClassId"
                          Margin="5"/>

                <!-- البحث -->
                <TextBox x:Name="txtSearch"
                         Grid.Column="5"
                         Margin="10,11,82,10"
                         VerticalContentAlignment="Center"
                         Padding="8"
                         Background="#F7F9FC"
                         BorderBrush="#D0D7E2"/>

                <Button Content="بحث"
                        Grid.Column="5"
                        Width="80"
                        Height="32"
                        Background="#3498DB"
                        Foreground="White"
                        Margin="125,12,135,11"
                        Click="Search_Click" Grid.ColumnSpan="2"/>

                <!-- تحميل -->
                <Button Content="تحميل الطلاب"
                        Grid.Column="6"
                        Width="120"
                        Height="32"
                        Background="#2D9CDB"
                        Foreground="White"
                        Margin="10,0"
                        Click="Load_Click"/>

                <!-- حاضر للجميع -->
                <Button Content="حاضر للجميع"
                        Grid.Column="7"
                        Width="120"
                        Height="32"
                        Background="#27AE60"
                        Foreground="White"
                        Margin="5,0"
                        Click="MarkAllPresent_Click"/>

                <!-- حفظ -->
                <Button Content="حفظ"
                        Grid.Column="8"
                        Width="90"
                        Height="32"
                        Background="#1F8A4C"
                        Foreground="White"
                        Margin="5,0"
                        Click="Save_Click"/>

                <!-- حذف -->
                <Button Content="🗑"
                        Grid.Column="9"
                        Width="45"
                        Height="32"
                        Background="#C0392B"
                        Foreground="White"
                        Margin="5,0"
                        Click="DeleteAttendance_Click"/>

                <!-- تصدير -->
                <Button Content="📤 Excel"
                        Grid.Column="10"
                        Width="100"
                        Height="32"
                        Background="#8E44AD"
                        Foreground="White"
                        Margin="5,0"
                        Click="ExportExcel_Click"/>

            </Grid>
        </Border>

        <!-- ================= STATS BAR ================= -->
        <Border Grid.Row="0"
                VerticalAlignment="Bottom"
                Margin="0,70,0,15"
                Background="Transparent">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <TextBlock x:Name="txtPresentCount"
                           Text="الحضور: 0"
                           FontWeight="Bold"
                           Foreground="#27AE60"
                           Margin="10,0"/>

                <TextBlock x:Name="txtAbsentCount"
                           Text="الغياب: 0"
                           FontWeight="Bold"
                           Foreground="#E74C3C"
                           Margin="20,0"/>

            </StackPanel>
        </Border>

        <!-- ================= STUDENTS ================= -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="15"
                Padding="10"
                BorderBrush="#E0E6ED"
                BorderThickness="1"
                Margin="0,0,0,15">

            <DataGrid x:Name="dgStudents"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          RowHeight="35"
          HeadersVisibility="Column"
          GridLinesVisibility="None"
          Background="White"
          BorderBrush="#DDE6F0"
          BorderThickness="1"
          AlternatingRowBackground="#F7FAFC"
          RowBackground="White">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="الصف"
                                        Binding="{Binding ClassName}"
                                        IsReadOnly="True"
                                        Width="160"/>

                    <DataGridTextColumn Header="اسم الطالب"
                                        Binding="{Binding StudentName}"
                                        IsReadOnly="True"
                                        Width="*"/>

                    <DataGridComboBoxColumn Header="الحالة"
                                            SelectedItemBinding="{Binding Status}"
                                            Width="160">
                        <DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type sys:String}">
                                <sys:String>حاضر</sys:String>
                                <sys:String>غائب</sys:String>
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>
                    </DataGridComboBoxColumn>
                    

                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>

                            <!-- غائب -->
                            <DataTrigger Binding="{Binding Status}" Value="غائب">
                                <Setter Property="Background" Value="#FDEDEC"/>
                                <Setter Property="Foreground" Value="#C0392B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>

                            <!-- حاضر -->
                            <DataTrigger Binding="{Binding Status}" Value="حاضر">
                                <Setter Property="Background" Value="#E9F7EF"/>
                                <Setter Property="Foreground" Value="#1E8449"/>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

            </DataGrid>

        </Border>

        <!-- ================= HISTORY ================= -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="15"
                Padding="10"
                BorderBrush="#E0E6ED"
                BorderThickness="1">

            <DataGrid x:Name="dgHistory"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      RowHeight="32"/>

        </Border>

    </Grid>
</Window>