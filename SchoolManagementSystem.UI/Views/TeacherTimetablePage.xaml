<Page x:Class="SchoolManagementSystem.Views.TeacherTimetablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:SchoolManagementSystem.Converters"
      FlowDirection="RightToLeft"
      Background="#F0F4F8"
      Title="جدول المدرسين">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush"/>
        <conv:BoolToVisConverter  x:Key="BoolVis"/>

        <Style x:Key="BtnGray" TargetType="Button">
            <Setter Property="Background"      Value="#64748B"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1E3A5F">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10"
                  Background="#7C3AED" Margin="0,0,12,0">
                        <TextBlock Text="👨‍🏫" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="جدول المدرسين" Foreground="White"
                       FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="عرض حصص أي مدرس بشكل فوري"
                       Foreground="#C4B5FD" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Background="White"
            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="المدرس:" VerticalAlignment="Center"
                     Foreground="#374151" FontSize="13" FontWeight="SemiBold"
                     Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding Employees}"
                    SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                    DisplayMemberPath="EmployeeName"
                    Width="220" Height="38" FontSize="13"/>
                </StackPanel>

                <!-- إجمالي الحصص -->
                <Border Grid.Column="1" Margin="20,0" VerticalAlignment="Center"
                HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="إجمالي الحصص الأسبوعية:" FontSize="12"
                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border CornerRadius="12" Background="#7C3AED" Padding="12,4">
                            <TextBlock Text="{Binding TotalWeekly}"
                         Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2" Content="🖨️ طباعة"
                Style="{StaticResource BtnGray}" Click="Print_Click"/>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- جدول المدرس (يُبنى ديناميكياً) -->
            <Border Grid.Column="0" Background="White" CornerRadius="12"
              BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="TeacherGrid" Margin="16"/>
                    </ScrollViewer>

                    <!-- loading -->
                    <Border Background="#CCF0F4F8"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="جارٍ التحميل..." FontSize="14" Foreground="#7C3AED"
                         HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- welcome -->
                    <Border x:Name="WelcomePanel">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="👨‍🏫" FontSize="52" HorizontalAlignment="Center"/>
                            <TextBlock Text="اختر مدرساً لعرض جدوله"
                         FontSize="16" Foreground="#94A3B8"
                         HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- SIDEBAR -->
            <Border Grid.Column="2" Background="White" CornerRadius="12"
              BorderBrush="#E2E8F0" BorderThickness="1"
              VerticalAlignment="Top" Padding="16">
                <StackPanel>
                    <TextBlock Text="📅 الحصص اليومية"
                     FontSize="14" FontWeight="Bold"
                     Foreground="#1E3A5F" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding DayStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DayName}" FontSize="12"
                               Foreground="#374151" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" CornerRadius="10"
                            Background="#F3F0FF" Padding="7,2">
                                            <TextBlock Text="{Binding Count}" FontSize="11"
                                 FontWeight="Bold" Foreground="#7C3AED"/>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" Height="5" CornerRadius="3"
                          Background="#EDE9FE" HorizontalAlignment="Stretch">
                                        <Border CornerRadius="3" Background="#7C3AED"
                            HorizontalAlignment="Right"
                            Width="{Binding BarWidth}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="لا توجد بيانات" FontSize="12"
                     Foreground="#CBD5E1" HorizontalAlignment="Center"
                     Margin="0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DayStats.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#F8FAFC"
            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,0">
            <TextBlock Text="{Binding Status}"
                 VerticalAlignment="Center"
                 FontSize="12" Foreground="#64748B"/>
        </Border>
    </Grid>
</Page>
