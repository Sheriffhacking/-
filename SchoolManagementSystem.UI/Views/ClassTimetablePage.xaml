<Page x:Class="SchoolManagementSystem.Views.ClassTimetablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:SchoolManagementSystem.Converters"
      FlowDirection="RightToLeft"
      Background="#F0F4F8"
      Title="جدول الصفوف">

    <Page.Resources>
        <conv:HexToBrushConverter  x:Key="HexBrush"/>
        <conv:BoolToVisConverter   x:Key="BoolVis"/>

        <!-- زر رئيسي -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"        Value="#2563EB"/>
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Padding"           Value="18,9"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnGray" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <!-- header -->
            <RowDefinition Height="Auto"/>
            <!-- toolbar -->
            <RowDefinition Height="*"/>
            <!-- content -->
            <RowDefinition Height="36"/>
            <!-- status -->
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0" Background="#1E3A5F">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10"
                  Background="#2563EB" Margin="0,0,12,0">
                        <TextBlock Text="📋" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="جدول الصفوف الدراسية" Foreground="White"
                       FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="إدخال يدوي – حفظ فوري تلقائي"
                       Foreground="#93C5FD" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ TOOLBAR ══════════════ -->
        <Border Grid.Row="1" Background="White"
            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
            Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- اختيار الصف -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="الصف الدراسي:" VerticalAlignment="Center"
                     Foreground="#374151" FontSize="13" FontWeight="SemiBold"
                     Margin="0,0,10,0"/>
                    <ComboBox x:Name="ClassCombo"
                    ItemsSource="{Binding Classes}"
                    SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                    DisplayMemberPath="ClassName"
                    Width="200" Height="38"
                    FontSize="13"
                    SelectionChanged="ClassCombo_SelectionChanged"/>
                </StackPanel>

                <!-- أزرار -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🖨️ طباعة" Style="{StaticResource BtnGray}"
                  Margin="0,0,8,0" Click="Print_Click"/>
                    <Button Content="📊 Excel" Style="{StaticResource BtnGray}"
                  Margin="0,0,8,0" Click="Export_Click"/>
                    <Button Content="🗑️ مسح الجدول" Style="{StaticResource BtnDanger}"
                  Click="Clear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ CONTENT ══════════════ -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- جدول -->
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="220"/>
                <!-- sidebar -->
            </Grid.ColumnDefinitions>

            <!-- جدول الصف (يُبنى ديناميكياً في Code-Behind) -->
            <Border Grid.Column="0" Background="White"
              CornerRadius="12" Padding="0"
              BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="TimetableGrid" Margin="16"/>
                    </ScrollViewer>

                    <!-- مؤشر تحميل -->
                    <Border Background="#CCF0F4F8"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="36"
                         HorizontalAlignment="Center"/>
                            <TextBlock Text="جارٍ التحميل..."
                         FontSize="14" Foreground="#2563EB"
                         HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- رسالة الترحيب -->
                    <Border x:Name="WelcomePanel" Background="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📚" FontSize="52"
                         HorizontalAlignment="Center"/>
                            <TextBlock Text="اختر صفاً لعرض الجدول"
                         FontSize="16" Foreground="#94A3B8"
                         HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ SIDEBAR ══ -->
            <Border Grid.Column="2" Background="White"
              CornerRadius="12" Padding="16"
              BorderBrush="#E2E8F0" BorderThickness="1"
              VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="📊 إحصائيات الصف"
                     FontSize="14" FontWeight="Bold"
                     Foreground="#1E3A5F" Margin="0,0,0,14"/>

                    <!-- قائمة المواد + عدد الحصص -->
                    <ItemsControl x:Name="StatsControl"
                        ItemsSource="{Binding SubjectStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="3"
                              VerticalAlignment="Center" Margin="0,0,6,0"
                              Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                 Foreground="#374151" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="10" Padding="7,2"
                            Background="#EFF6FF">
                                            <TextBlock Text="{Binding Count}" FontSize="11"
                                 FontWeight="Bold" Foreground="#2563EB"/>
                                        </Border>
                                    </Grid>

                                    <!-- شريط التقدم -->
                                    <Border Grid.Row="1" Height="4" CornerRadius="2"
                          Background="#F1F5F9" HorizontalAlignment="Stretch">
                                        <Border CornerRadius="2"
                            HorizontalAlignment="Right"
                            Width="{Binding BarWidth}"
                            Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- فارغة -->
                    <TextBlock Text="لا توجد بيانات بعد"
                     FontSize="12" Foreground="#CBD5E1"
                     HorizontalAlignment="Center" Margin="0,16"
                     Visibility="{Binding SubjectStats.Count,
                         Converter={StaticResource BoolVis}}"/>

                    <Separator Margin="0,16"/>

                    <!-- ملخص سريع -->
                    <TextBlock Text="💡 تعليمات"
                     FontSize="13" FontWeight="Bold"
                     Foreground="#1E3A5F" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                     Foreground="#64748B" LineHeight="18">
            <Run Text="• اختر الصف من الأعلى"/>
            <LineBreak/>
            <Run Text="• اختر المادة والمدرس لكل خلية"/>
            <LineBreak/>
            <Run Text="• يتم الحفظ فوراً تلقائياً ✓"/>
            <LineBreak/>
            <Run Text="• اترك الخلية فارغة = لا حصة"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════ STATUS BAR ══════════════ -->
        <Border Grid.Row="3" Background="#F8FAFC"
            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
            Padding="20,0">
            <TextBlock Text="{Binding Status}"
                 VerticalAlignment="Center"
                 FontSize="12" Foreground="#64748B"/>
        </Border>
    </Grid>
</Page>
